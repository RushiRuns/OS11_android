<resources>
    <!-- Base application theme for Jetpack Compose (dark only per ARCHITECTURE.md) -->
    <style name="Theme.OS11" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#FF1C1C1C</item>
    </style>

    <!-- Splash screen theme using core-splashscreen -->
    <style name="Theme.OS11.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FF1C1C1C</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.OS11</item>
    </style>
</resources>